#!/usr/bin/env bash
# This script configures the /etc/hosts file so that:
# - localhost resolves to 127.0.0.2
# - facebook.com resolves to 8.8.8.8

# Remove existing entries for localhost and facebook.com safely without busy error
sudo grep -v -E '\blocalhost\b|\bfacebook.com\b' /etc/hosts | sudo tee /etc/hosts > /dev/null

# Append the new configurations to the /etc/hosts file
echo "127.0.0.2 localhost" | sudo tee -a /etc/hosts > /dev/null
echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts > /dev/null
